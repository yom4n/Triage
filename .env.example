# Copy this file to `.env` and adjust as needed. app/config.py reads these
# via pydantic-settings; every value below has a matching default so the
# app also runs with zero .env file for local development.

APP_ENV=development
LOG_LEVEL=INFO

POSTGRES_USER=triage_user
POSTGRES_PASSWORD=triage_password
POSTGRES_DB=triage_engine
POSTGRES_HOST=localhost
# 55432, not the Postgres default 5432 -- docker-compose.yml maps the
# container to this host port because Windows machines commonly already
# have a native Postgres service bound to 5432/5433, which silently
# intercepts connections meant for the container (wrong credentials)
# instead of erroring. Change both this and docker-compose.yml's
# postgres.ports entry together if 55432 collides with something on yours.
POSTGRES_PORT=55432

REDIS_HOST=localhost
REDIS_PORT=6379

# -- LLM reasoning (Phase 2) --------------------------------------------------
# "ollama" (default): fully local, no API key, no per-token cost. Requires
# `ollama serve` running on the host and the chat model pulled:
#   ollama pull qwen2.5:7b-instruct
# "anthropic": Claude via the official SDK. Requires ANTHROPIC_API_KEY below
# (or an `ant auth login` profile) if you switch to it.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct
ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=sk-ant-...
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1
LLM_MAX_TRACE_CHARS=4000

# -- Embeddings (Phase 2) ------------------------------------------------------
# "ollama" (default): real semantic embeddings, local, no API key. Requires:
#   ollama pull nomic-embed-text
# "deterministic": offline hashing vectorizer, no service required -- useful
# for CI / a dependency-free smoke test, never for real similarity search.
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
EMBEDDING_TIMEOUT_SECONDS=60

# -- RAG retrieval --------------------------------------------------------------
RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.35
MIN_CONFIDENCE=0.70

# -- CORS (Phase 4: crash ingestion from a monitored app's browser) -----------
# POST /api/v1/ingest/crash is called directly from a monitored app's own
# browser runtime (see client-sdks/), which is a different origin. "*" is
# fine for local/demo use monitoring apps you control; list exact origins
# (comma-separated) for anything more real.
CORS_ALLOW_ORIGINS=*

# -- GitHub auto-fix (Phase 4b: propose_fix_node) ------------------------------
# Optional -- propose_fix_node no-ops (ticket still completes normally) if
# GITHUB_REPO is unset, or opens no PR (stays read-only) if GITHUB_TOKEN is
# unset. A fine-grained PAT scoped to just GITHUB_REPO, with "Contents:
# read and write" + "Pull requests: read and write", is enough.
# GITHUB_TOKEN=github_pat_...
GITHUB_REPO=yom4n/todotest
GITHUB_BASE_BRANCH=main
